# DataNexus environment variables
# Copy to .env.local and fill in your values

# Prisma / app database (stores app registry, keys, audit log)
DATABASE_URL="postgresql://datanexus_user:yourpassword@localhost:5432/datanexus"

# Admin Postgres connection (used to provision schemas for registered apps)
# Must have CREATEDB / CREATEROLE privileges
PG_HOST=localhost
PG_PORT=5432
PG_DB=datanexus
PG_ADMIN_USER=datanexus_admin
PG_ADMIN_PASSWORD=yourpassword

# Control-plane admin token (REQUIRED). At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Every management API call (apps, keys, audit, schema, dashboards) must send
#   Authorization: Bearer <this token>
# and the web UI asks for it once on /login. Unset or too short = the whole
# control plane answers 503 (fail closed). Rotating it signs out every UI session.
DATANEXUS_ADMIN_TOKEN=

# Public host shown in generated connection strings
APP_DB_HOST=your-vps-ip-or-domain
APP_DB_PORT=5432
APP_DB_NAME=datanexus
